# Server Port
PORT=5000

# MongoDB Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/primeroadways
MONGODB_URI=mongodb://localhost:27017/primeroadways

# JSON Web Token Secret
# Generate a strong secret key for production (e.g., using `crypto.randomBytes(64).toString('hex')`)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS — set this to your deployed frontend domain)
# e.g., https://primeroadways.vercel.app
FRONTEND_URL=http://localhost:5173

# Render External URL (for keep-alive self-ping — auto-set by Render, or set manually)
# e.g., https://prime-roadways-api.onrender.com/api/health
# RENDER_EXTERNAL_URL=https://your-app.onrender.com/api/health
